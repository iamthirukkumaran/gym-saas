# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./prisma/astryx.db"
AUTH_SECRET="generate-with: openssl rand -base64 48"
CRON_SECRET="generate-with: openssl rand -hex 24"

# sandbox | meta | aisensy | wati | interakt
WHATSAPP_PROVIDER="sandbox"

# Only needed when WHATSAPP_PROVIDER=meta (per-gym values override these)
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_API_VERSION="v21.0"

# Only needed for an Indian BSP
BSP_API_KEY=""
BSP_BASE_URL=""
APP_URL="http://localhost:3000"
